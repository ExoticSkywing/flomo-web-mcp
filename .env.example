# Required: copy this file to .env and fill with your own flomo Web credentials.
FLOMO_AUTHORIZATION=

# Optional session/header values captured from flomo Web.
FLOMO_COOKIE=
FLOMO_USER_AGENT=Mozilla/5.0
FLOMO_DEVICE_ID=
FLOMO_DEVICE_MODEL=Other
FLOMO_WEB_PLATFORM=Web

# Optional endpoint and runtime settings.
FLOMO_BASE_URL=https://flomoapp.com
FLOMO_WEB_BASE_URL=https://v.flomoapp.com
FLOMO_TIMEZONE=Asia/Shanghai
FLOMO_REQUEST_TIMEOUT_MS=30000
LOG_LEVEL=info

# Only override these if flomo Web internal endpoints change.
FLOMO_READ_ENDPOINT=
FLOMO_SYNC_ENDPOINT=
FLOMO_WRITE_ENDPOINT=
