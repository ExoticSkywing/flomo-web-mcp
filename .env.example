# Required after you capture it from flomo Web DevTools.
FLOMO_AUTHORIZATION=Bearer xxxxxxxxxxxxxxxxx

# Defaults are usually enough for first local testing.
FLOMO_BASE_URL=https://flomoapp.com
FLOMO_WEB_BASE_URL=https://v.flomoapp.com
FLOMO_USER_AGENT=Mozilla/5.0
# IANA timezone used for X-Timezone and signed flomo Web tz parameters.
FLOMO_TIMEZONE=Asia/Shanghai
LOG_LEVEL=info

# Optional Web-device headers. Leave empty unless a captured request proves a
# specific value is required; the server can generate a runtime device id.
# FLOMO_DEVICE_ID=
# FLOMO_DEVICE_MODEL=Other
# FLOMO_WEB_PLATFORM=Web

# Optional fallback if write endpoints require cookies.
# FLOMO_COOKIE=

# The current default read endpoint is signed dynamically by the adapter.
# Override only if flomo Web changes its internal path.
# FLOMO_READ_ENDPOINT=/api/v1/memo/latest_updated_desc

# The current default write endpoint is signed dynamically in the JSON body.
# Override only if flomo Web changes its internal path.
# FLOMO_WRITE_ENDPOINT=/api/v1/memo

# Keep false unless you are actively debugging parser changes.
FLOMO_DEBUG_RAW_RESPONSE=false
